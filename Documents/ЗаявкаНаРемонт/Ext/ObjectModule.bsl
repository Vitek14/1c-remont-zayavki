// 1. Проверка перед проведением (Поведение №2)
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
    Если Статус = Перечисления.СтатусыЗаявки.Выполнена 
        И НЕ ЗначениеЗаполнено(Работы) Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Нельзя провести заявку со статусом «Выполнена», 
                           |если табличная часть «Работы» не заполнена.";
        Сообщение.Сообщить();
        Отказ = Истина;
    КонецЕсли;
КонецПроцедуры

// 2. Запись истории статусов (Поведение №3)
Процедура ОбработкаПроведения(Отказ, Режим)
    // Проверяем, изменился ли статус по сравнению с последней записью в регистре
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   СтатусыЗаявок.Статус
        |ИЗ
        |   РегистрСведений.СтатусыЗаявок КАК СтатусыЗаявок
        |ГДЕ
        |   СтатусыЗаявок.Заявка = &Заявка
        |УПОРЯДОЧИТЬ ПО
        |   СтатусыЗаявок.Период УБЫВ";
    Запрос.УстановитьПараметр("Заявка", Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();

    // Если статус не изменился, выходим и не создаём лишнюю запись
    Если Выборка.Следующий() И Выборка.Статус = Статус Тогда
        Возврат;
    КонецЕсли;

    // Статус изменился (или это первое проведение) — добавляем запись в регистр
    НоваяЗапись = Движения.СтатусыЗаявок.Добавить();
    НоваяЗапись.Период = Дата; // В качестве периода используем дату документа
    НоваяЗапись.Заявка = Ссылка;
    НоваяЗапись.Статус = Статус;
КонецПроцедуры
